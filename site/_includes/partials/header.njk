<header class="site-header">
  <div class="shell header-inner">
    <a class="profile-avatar" href="/" aria-label="Ibrahim Yildiz home"><img src="{{ site.links.avatar }}" alt="Ibrahim Yildiz"></a>
    <nav aria-label="Primary navigation">
      {% set currentLanguage = language | default('en') %}
      {% set isAboutPage = page.url == "/tr/about/" or page.url == "/en/about/" %}
      <a href="/{{ currentLanguage }}/">{{ "Notes" if currentLanguage == "en" else "Yazilar" }}</a>
      <a href="/{{ currentLanguage }}/archive/">{{ "Archive" if currentLanguage == "en" else "Arsiv" }}</a>
      <a href="/{{ currentLanguage }}/tags/">{{ "Tags" if currentLanguage == "en" else "Etiketler" }}</a>
      <a href="/{{ currentLanguage }}/search/">{{ "Search" if currentLanguage == "en" else "Ara" }}</a>
      <a href="/{{ currentLanguage }}/about/">{{ "About" if currentLanguage == "en" else "Hakkimda" }}</a>
    </nav>
    <div class="language-switch" aria-label="Language">
      {% if currentLanguage == "tr" %}
        <a href="{{ "/en/about/" if isAboutPage else "/en/" }}">EN</a><span aria-hidden="true">/</span><strong>TR</strong>
      {% else %}
        <strong>EN</strong><span aria-hidden="true">/</span><a href="{{ "/tr/about/" if isAboutPage else "/tr/" }}">TR</a>
      {% endif %}
    </div>
  </div>
</header>
