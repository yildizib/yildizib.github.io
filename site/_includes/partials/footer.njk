<footer class="site-footer">
  <div class="shell footer-inner">
    <div class="footer-copy">
      <p>{{ "Written and maintained by" if language != "tr" else "Yazan ve sürdüren:" }} {{ site.author }}.</p>
      <a class="license-link" href="{{ site.license.url }}" rel="license" aria-label="{{ 'Content licensed under' if language != 'tr' else 'İçerik lisansı:' }} {{ site.license.name }}" title="{{ site.license.name }}">
        <img src="{{ site.license.badge }}" alt="{{ site.license.name }}">
      </a>
    </div>
    <a href="/{{ language | default('en') }}/feed.xml">RSS</a>
  </div>
</footer>
