<article class="post-card">
  <p class="eyebrow">{{ post.date | readableDate(post.data.language) }}</p>
  <h2><a href="{{ post.url }}">{{ post.data.title }}</a></h2>
  <p>{{ post.data.description }}</p>
  <ul class="tag-list" aria-label="Tags">
    {% for tag in post.data.tags %}
      {% if tag != "posts" %}<li><a href="/{{ post.data.language }}/tags/{{ tag | slugify }}/">{{ tag }}</a></li>{% endif %}
    {% endfor %}
  </ul>
</article>
