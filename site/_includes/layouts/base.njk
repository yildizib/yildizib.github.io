<!doctype html>
<html lang="{{ language | default('en') }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="description" content="{{ description or site.description }}">
    <meta name="color-scheme" content="light dark">
    <link rel="canonical" href="{{ site.url }}{{ page.url }}">
    {% if translation_key %}
      {% for post in collections.all %}
        {% if post.data.translation_key == translation_key and post.url != page.url %}
          <link rel="alternate" hreflang="{{ post.data.language }}" href="{{ site.url }}{{ post.url }}">
        {% endif %}
      {% endfor %}
    {% endif %}
    <link rel="alternate" type="application/atom+xml" title="{{ site.title }}" href="/{{ language | default('en') }}/feed.xml">
    <link rel="stylesheet" href="/assets/css/main.css">
    {% if math %}<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.22/dist/katex.min.css">{% endif %}
    {% if mermaid %}
      <link rel="preconnect" href="https://fonts.googleapis.com">
      <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
      <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Kalam:wght@300;400;700&display=swap">
    {% endif %}
    <title>{% if title %}{{ title }} | {% endif %}{{ site.title }}</title>
  </head>
  <body>
    {% include "partials/header.njk" %}
    <main class="shell">{{ content | safe }}</main>
    {% include "partials/footer.njk" %}
    {% if mermaid %}
      <script type="module">
        import mermaid from "https://cdn.jsdelivr.net/npm/mermaid@11.12.1/dist/mermaid.esm.min.mjs";

        const isDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
        mermaid.initialize({
          startOnLoad: false,
          securityLevel: "strict",
          theme: "base",
          look: "handDrawn",
          fontFamily: "Kalam, cursive",
          themeVariables: isDark ? {
            primaryColor: "#202a24",
            primaryTextColor: "#edf1ea",
            primaryBorderColor: "#edf1ea",
            secondaryColor: "#3a2923",
            tertiaryColor: "#18201c",
            lineColor: "#aab4aa",
            clusterBkg: "#202a24",
            clusterBorder: "#aab4aa"
          } : {
            primaryColor: "#fffdf8",
            primaryTextColor: "#1e2722",
            primaryBorderColor: "#1e2722",
            secondaryColor: "#f1ded5",
            tertiaryColor: "#f7f4ee",
            lineColor: "#657066",
            clusterBkg: "#fffdf8",
            clusterBorder: "#657066"
          }
        });
        document.querySelectorAll(".post-body pre > code.language-mermaid").forEach((code) => {
          const diagram = document.createElement("div");
          diagram.className = "mermaid";
          diagram.textContent = code.textContent;
          code.parentElement.replaceWith(diagram);
        });
        await mermaid.run({ querySelector: ".mermaid" });
      </script>
    {% endif %}
  </body>
</html>
