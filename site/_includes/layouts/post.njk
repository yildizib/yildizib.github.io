---
layout: layouts/base.njk
ogType: article
---
<article class="post flow">
  <header class="post-header">
    <p class="eyebrow">{{ date | readableDate(language) }}{% if status == "draft" %} · {{ "Draft" if language == "en" else "Taslak" }}{% endif %}</p>
    <h1>{{ title }}</h1>
    <p class="lede">{{ description }}</p>
    {% if tags %}
      <ul class="tag-list" aria-label="{{ 'Tags' if language == 'en' else 'Etiketler' }}">
        {% for tag in tags %}
          {% if tag != "posts" %}<li><a href="/{{ language }}/tags/{{ tag | slugify }}/">{{ tag }}</a></li>{% endif %}
        {% endfor %}
      </ul>
    {% endif %}
  </header>

  {% set translatedPost = collections.translatedPosts | translationFor(translation_key, language) %}
  {% if translatedPost %}
    <aside class="translation-notice">
      {% if language == "tr" %}
        Bu yazının İngilizce sürümü de mevcut: <a href="{{ translatedPost.url }}">English version</a>
      {% else %}
        This post is also available in Turkish: <a href="{{ translatedPost.url }}">Türkçe sürüm</a>
      {% endif %}
    </aside>
  {% endif %}

  <div class="post-body">{{ content | safe }}</div>

  {% if references %}
    <footer class="references">
      <h2>{{ "Internal references" if language == "en" else "İçerik referansları" }}</h2>
      <ul>
        {% for reference in references %}
          <li><code>{{ reference.path }}</code>{% if reference.role %} <span>{{ reference.role }}</span>{% endif %}</li>
        {% endfor %}
      </ul>
    </footer>
  {% endif %}
</article>
