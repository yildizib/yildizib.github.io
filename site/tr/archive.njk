---
layout: layouts/base.njk
title: "Arşiv"
description: "Türkçe yazıların yıllara göre arşivi."
language: tr
permalink: /tr/archive/index.html
---
<section class="archive flow"><p class="eyebrow">Türkçe</p><h1>Arşiv</h1>{% if collections.posts_tr.length %}{% for group in collections.posts_tr | yearGroups %}<section><h2>{{ group.year }}</h2><ul class="archive-list">{% for post in group.entries %}<li><time datetime="{{ post.date | isoDate }}">{{ post.date | readableDate('tr') }}</time><a href="{{ post.url }}">{{ post.data.title }}</a></li>{% endfor %}</ul></section>{% endfor %}{% else %}<p class="empty-state">Arşiv şu anda boş.</p>{% endif %}</section>
